<clickhouse>
    <!-- An idle instance left running for months dies of system-log growth.
         30 days is plenty for a playground. -->
    <query_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_log>
    <trace_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </trace_log>
    <part_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </part_log>
    <metric_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </asynchronous_metric_log>
</clickhouse>
